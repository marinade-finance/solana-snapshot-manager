{
  "name": "solana-snapshot-manager",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "cli": "nest start --entryFile ./src/cli",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.28.1-beta.1",
    "@marinade.finance/directed-stake-sdk": "^0.1.0",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "11.7.0",
    "bn.js": "^5.2.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv": "^6.6.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "isomorphic-fetch": "^3.0.0",
    "jsbi": "^4.3.2",
    "json-stream-stringify": "^3.1.7",
    "keyv": "^5.6.0",
    "log4js": "^6.9.1",
    "nest-commander": "^3.21.0",
    "pq": "^0.0.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "slonik": "^49.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@streamparser/json-node": "0.0.21",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^8.2.13",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jest": "^30.0.0",
    "@types/node": "18.15.11",
    "@types/pg": "^8.23.1",
    "@types/streaming-json-stringify": "^3.1.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "gts": "^6.0.2",
    "jest": "30.5.2",
    "prettier": "3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 1
  }
}
